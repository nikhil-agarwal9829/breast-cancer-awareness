{
  "deployment": {
    "type": "zip",
    "source": ".",
    "target": "appservice",
    "exclude": [
      "node_modules",
      ".git",
      ".azure",
      "*.md",
      ".vscode",
      ".idea"
    ]
  },
  "build": {
    "preDeploy": [
      "npm install",
      "npm run build"
    ],
    "postDeploy": [
      "echo 'Deployment completed successfully'"
    ]
  },
  "environment": {
    "NODE_ENV": "production",
    "PORT": "3001"
  }
}

